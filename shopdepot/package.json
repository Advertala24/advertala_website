{
  "name": "shopdepot-lander",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/xml.test.js",
    "report": "bash scripts/report.sh",
    "listings": "bash scripts/listings.sh",
    "dev": "bash scripts/dev.sh",
    "dev:mock": "bash scripts/dev.sh --mock",
    "mock": "node scripts/mock-api.mjs",
    "smoke": "bash scripts/smoke.sh",
    "docker:build": "docker build -t shopdepot-lander .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env shopdepot-lander"
  },
  "dependencies": {
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
