# Copy to .env (never commit the real key)
MWG_KEY=your-api-key
# Default subid sent as `type` when the visitor URL has no ?subid=
DEFAULT_SUBID=shopdepot
# Number of ads requested per page
NUM_ADS=3
# Public URL of the results page, no query string (sent as serveUrl)
SERVE_URL=https://marketplace.shopdepot.us/results
# Beacon source tag
SOURCE_TAG=mediawave_n2s_xmlb_11649_fb_shopdepot
PORT=3000
# Set to 1 to log raw XML from the listings API (for debugging the parser)
DEBUG_RAW=0
